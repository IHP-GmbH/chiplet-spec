#
# Validation rule 8 positive, and the twin of
# v1_0_interface_pad_mismatch.chiplet: the SAME wire_bond pad and the SAME
# copper_pillar interface, with the pad on another layer. The endpoint's pad set
# is scoped by port_layer, so the set here is {B1} and J1 is not in it; the
# document is accepted.
#
# Without this file the negative alone would still pass if a reader ignored
# port_layer and judged every pad on the component, which is a stricter rule
# than the spec's and would refuse real interposers.
format_version: "1.0"

assembly:
  name: "Rule 8 positive: the mismatched pad is on another layer"

components:
  - id: interposer
    type: interposer
    io_pads:
      - id: J1
        io_class: wire_bond
        net: VDD
        position: {x: 100.0, y: 100.0}
        size: {x: 80.0, y: 80.0}
        layer: TopMetal2
      - id: B1
        io_class: flipped_bump
        net: VDD
        position: {x: 1500.0, y: 2801.0}
        size: {x: 25.0, y: 25.0}
        layer: TopMetal1

  - id: U1
    type: die

interfaces:
  - id: link0
    type: copper_pillar
    from: {component: U1, surface: bottom, port_layer: TopMetal1}
    to:   {component: interposer, surface: top, port_layer: TopMetal1}
